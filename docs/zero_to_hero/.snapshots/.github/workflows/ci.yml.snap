name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  python:
    name: Python - lint, types, tests, book
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
          enable-cache: true
      - run: uv sync --locked
      - run: uv run infra/scripts/fetch_models.py
      - run: sudo apt-get update && sudo apt-get install --yes --no-install-recommends tesseract-ocr
      - run: uv run tasks.py lint
      - run: uv run tasks.py typecheck
      # The tests, one step per run so each has its own time on record; each test's name is logged as it starts.
      - name: Tests - services, libraries, SDK
        timeout-minutes: 20
        shell: bash
        run: uv run python -m pytest docs/zero_to_hero/tests services libs packages/sdk-python -v --durations=15 2>&1 | tee services-tests.log
      - name: Tests - ML
        timeout-minutes: 15
        shell: bash
        run: uv run python -m pytest ml -v --durations=15 2>&1 | tee ml-tests.log
      - name: The book
        shell: bash
        run: uv run tasks.py book 2>&1 | tee book.log
      # As with the tests below: what the book's check found wrong, where it can be read without a sign-in.
      - name: The book's problems, as an annotation
        if: failure()
        shell: bash
        run: |
          [ -f book.log ] || exit 0
          found=$(grep -E '^  (problem|incomplete):' book.log | head -30 | tr '\n' '|')
          echo "::error title=book::${found:-no problem lines; last line: $(tail -1 book.log)}"
      # CI's logs need a GitHub sign-in; annotations don't. Post the slowest tests, and the last lines reached (the
      # test that was running if a step ran out of time), as annotations.
      - name: Test timings, as annotations
        if: always()
        shell: bash
        run: |
          for log in services-tests.log ml-tests.log; do
            [ -f "$log" ] || continue
            slowest=$(sed -n '/slowest .* durations/,/^=/p' "$log" | head -17 | tr '\n' '|')
            last=$(grep -E '::' "$log" | tail -3 | tr '\n' '|')
            echo "::notice title=$log::slowest: ${slowest:-none recorded} last reached: ${last:-none}"
          done

  javascript:
    name: JavaScript - lint, types, tests, builds
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm lint
      - run: pnpm typecheck
      - run: pnpm test
      - run: pnpm build

  e2e:
    name: End to end - a real browser through every service
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
          enable-cache: true
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24
          cache: pnpm
      - run: uv sync --locked
      - run: uv run infra/scripts/fetch_models.py
      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter @dwarpal/e2e exec playwright install --with-deps chromium firefox webkit
      - run: pnpm e2e
      - if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: e2e-results
          path: e2e/test-results
          retention-days: 7

  infrastructure:
    name: Compose - databases start healthy
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - run: docker compose -f infra/compose/compose.yaml up -d --wait
      - run: docker compose -f infra/compose/compose.yaml down -v
      # The server's alert settings (alerts by email, 2 Nov), checked by each program's own checker: Prometheus's with
      # the shared rules, the collector's, and Alertmanager's as alert_email.py writes them (a made-up password).
      - name: Production alert settings are valid
        run: |
          python3 - <<'PY'
          import importlib.util
          spec = importlib.util.spec_from_file_location("alert_email", "infra/deploy/alert_email.py")
          mail = importlib.util.module_from_spec(spec)
          spec.loader.exec_module(mail)
          config = mail.alertmanager_config("owner@example.org", "smtp.example.org:587", "sender@example.org")
          open("alertmanager.yml", "w").write(config)
          open("smtp_password", "w").write("not-a-real-password")
          PY
          docker run --rm --entrypoint promtool \
            -v "$PWD/infra/deploy/prometheus.yaml:/etc/prometheus/prometheus.yaml:ro" \
            -v "$PWD/infra/observability/alerts.yaml:/etc/prometheus/alerts.yaml:ro" \
            prom/prometheus:v3.13.4 check config /etc/prometheus/prometheus.yaml
          docker run --rm -v "$PWD/infra/deploy/collector.yaml:/config.yaml:ro" \
            otel/opentelemetry-collector-contrib:0.163.1 validate --config=/config.yaml
          docker run --rm --entrypoint amtool \
            -v "$PWD/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro" \
            -v "$PWD/smtp_password:/etc/alertmanager/smtp_password:ro" \
            prom/alertmanager:v0.34.1 check-config /etc/alertmanager/alertmanager.yml

  helm:
    name: Helm - the Kubernetes chart lints and renders
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      HELM: helm-v4.3.1-linux-amd64.tar.gz
      HELM_SHA256: 0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # Helm 4.3.1 (decision D19), from Helm's own site, used only if its SHA-256 is the one written above.
      - run: |
          curl --fail --silent --show-error --location --output "$HELM" "https://get.helm.sh/$HELM"
          echo "$HELM_SHA256  $HELM" | sha256sum --check --strict
          tar --extract --gzip --file "$HELM" linux-amd64/helm
      - name: Lint and render
        shell: bash
        run: |
          ./linux-amd64/helm lint --strict infra/helm/dwarpal 2>&1 | tee helm.log
          ./linux-amd64/helm template dwarpal infra/helm/dwarpal > rendered.yaml 2>> helm.log
          echo "rendered $(grep -c '^kind:' rendered.yaml) objects" | tee -a helm.log
      # As for the tests: the end of Helm's output as an annotation, which anyone can read.
      - if: always()
        shell: bash
        run: '[ -f helm.log ] && echo "::notice title=helm::$(tail -c 2500 helm.log | tr "\n" "|")" || true'

  images:
    name: Images - the four production images build and start (Arm, never published)
    # Built exactly as the deploy workflow builds them — on GitHub's Arm machines, from the base images approved for
    # them (D17) — but kept here, never published: a broken image shows up on any push, not on the day of a deploy.
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 45
    strategy:
      fail-fast: false
      matrix:
        include:
          - { name: api, file: services/api/Dockerfile, args: "" }
          - { name: inference, file: services/inference/Dockerfile, args: "" }
          - { name: web, file: apps/Dockerfile, args: "APP=web" }
          - { name: demo-shop, file: apps/Dockerfile, args: "APP=demo-shop" }
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
      # The web app's build copies the face landmarker for browsers (the only model file an image contains); the
      # inference service reads all the serving models, mounted into it as on the server.
      - if: matrix.name == 'web' || matrix.name == 'inference'
        run: uv run --no-project --with httpx==0.28.1 infra/scripts/fetch_models.py
      # A failed build or start leaves its last lines as an annotation: anyone can read those, while logs need a sign-in.
      - name: Build
        shell: bash
        run: |
          args=(--build-arg "NEXT_PUBLIC_DWARPAL_API_URL=https://api.dwarpal.example")
          if [ -n "${{ matrix.args }}" ]; then args+=(--build-arg "${{ matrix.args }}"); fi
          docker build -f "${{ matrix.file }}" "${args[@]}" -t "dwarpal-${{ matrix.name }}:ci" . > build.log 2>&1 \
            || { tail -40 build.log; echo "::error title=${{ matrix.name }} build::$(tail -c 3000 build.log | tr '\n' '|')"; exit 1; }
      # Each image is started the way the server would, as far as it can be without the rest: the API loads all its
      # code; the inference service runs read-only with the fetched models mounted and must say Tesseract is ready
      # (the anti-spoofing networks are made from PyTorch weights on the owner's computer, so here they are missing);
      # the web app serves a verify page.
      - name: Start
        shell: bash
        run: |
          image="dwarpal-${{ matrix.name }}:ci"
          {
            case "${{ matrix.name }}" in
              api) docker run --rm "$image" python -m dwarpal_api.cli --help > /dev/null ;;
              inference)
                docker run --detach --name inference --read-only --tmpfs /tmp -v "$PWD/models:/models:ro" \
                  --publish 8001:8001 "$image" \
                  && ready=$(curl --fail --silent --show-error --retry 30 --retry-connrefused --retry-all-errors \
                    --retry-delay 2 http://localhost:8001/readyz) \
                  && echo "::notice title=inference readiness::$ready" \
                  && [[ "$ready" == *'"status":"ready"'* && "$ready" == *'"ocr":"ready"'* ]] \
                  || { docker logs inference 2>&1 | tail -20; false; } ;;
              web)
                docker run --detach --name web --publish 3000:3000 "$image" \
                  && curl --fail --silent --show-error --retry 20 --retry-connrefused --retry-all-errors --retry-delay 1 \
                  --output /dev/null http://localhost:3000/v/vs_01M51KF05CE4GSBH7F0G43G01V \
                  || { docker logs web 2>&1 | tail -20; false; } ;;
              demo-shop) docker run --rm "$image" node -e "require.resolve('next'); require('fs').accessSync('.next/BUILD_ID')" ;;
            esac
          } > start.log 2>&1 \
            || { cat start.log; echo "::error title=${{ matrix.name }} start::$(tail -c 3000 start.log | tr '\n' '|')"; exit 1; }
          # Notices written inside the braces went to the log: pass them on, so GitHub shows them.
          grep '^::notice' start.log || true
      # The API's image rehearses the server's first deploy, as far as one image can: the production Compose file's
      # databases, the real migrations, the services' restricted login, the API in production mode — then a backup and
      # the restore drill, with restic keeping its repository in its cache volume instead of Object Storage.
      - name: Rehearse the first deploy, a backup and the restore drill
        if: matrix.name == 'api'
        shell: bash
        working-directory: infra/deploy
        run: |
          exec > >(tee rehearsal.log) 2>&1
          python3 gen_secrets.py --domain dwarpal.example --email ci@example.org --ghcr-owner ci
          sed -i 's/^DWARPAL_TAG=.*/DWARPAL_TAG=ci/' .env
          docker tag dwarpal-api:ci ghcr.io/ci/dwarpal-api:ci
          mkdir -p models/registry/age/stub
          cp ../../models/registry/age/stub/manifest.json models/registry/age/stub/
          api="$(grep '^DWARPAL_DB_API_PASSWORD=' .env | cut -d= -f2-)"
          # As deploy.sh does: the databases, the migrations as the database's owner, then the services' own login.
          docker compose up -d --wait postgres valkey
          docker compose run --rm --no-deps operator migrate
          docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U dwarpal -d dwarpal -v pw="$api" <<'SQL'
          SELECT 'CREATE ROLE dwarpal_api LOGIN IN ROLE dwarpal_app'
          WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'dwarpal_api')
          \gexec
          ALTER ROLE dwarpal_api WITH LOGIN PASSWORD :'pw';
          SQL
          # The API alone (its inference service isn't needed to be ready), in production mode, as dwarpal_api.
          docker compose up -d --no-deps --wait --wait-timeout 180 api
          ready="$(docker compose exec -T api python -c \
            "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8000/readyz').read().decode())")"
          echo "::notice title=API in production mode::$ready"
          # The jobs that work across every organisation see every organisation: demo data made, then the hourly
          # maintenance's own login checks every organisation's audit chain (dwarpal_api would find none).
          docker compose run --rm --no-deps operator seed-dev > /dev/null
          audit="$(docker compose run --rm --no-deps --entrypoint python maintenance -m dwarpal_api.cli verify-audit)"
          [[ "$audit" != 0\ organisations* ]] || { echo "the maintenance job sees no organisation: $audit"; exit 1; }
          docker compose run --rm --no-deps --entrypoint python maintenance -m dwarpal_api.cli maintain
          docker compose run --rm --no-deps webhooks python -m dwarpal_api.cli deliver-webhooks --once
          echo "::notice title=jobs across organisations::$(tr '\n' '|' <<<"$audit")"
          # A backup into a repository kept in restic's cache volume, and the drill that restores it.
          printf 'RESTIC_REPOSITORY=/cache/rehearsal\nRESTIC_PASSWORD=%s\n' "$(openssl rand -hex 24)" > backup.env
          chmod 600 backup.env
          ./backup.sh
          report="$(./restore_drill.sh)"
          echo "::notice title=restore drill::$(tr '\n' '|' <<<"$report")"
          # The secrets file comes back as the runbook (section 4) brings it back for a lost server — here with the
          # cache volume too, where this rehearsal keeps its repository — and is the very file that was backed up.
          docker run --rm --env-file backup.env -v dwarpal-restic-cache:/cache -v "$PWD/restored:/restored" \
            restic/restic:0.19.1 restore latest --tag secrets --target /restored
          sudo cmp restored/secrets/.env .env
          echo "::notice title=secrets restore::.env restored from the backup, identical to the original"
          # Alerts by email, switched on as README step 10 does — a made-up mail password, typed twice — then the
          # collector, Prometheus and Alertmanager started with the files it wrote, and the API restarted to send counts.
          cp ../observability/alerts.yaml .
          printf 'not-a-real-password\nnot-a-real-password\n' | python3 alert_email.py --to owner@example.org \
            --smtp-host smtp.example.org:587 --smtp-user sender@example.org
          docker compose up -d --no-deps --wait --wait-timeout 120 collector alertmanager prometheus
          docker compose up -d --no-deps --wait --wait-timeout 180 api
          # Requests the API counts (health checks aren't), until Prometheus has the counts the alert rules read and the
          # availability rule computes a share from them.
          ask() { docker compose exec -T prometheus wget -qO- "http://127.0.0.1:9090/api/v1/$1"; }
          for _ in $(seq 1 24); do
            docker compose exec -T api python -c "import urllib.request; urllib.request.urlopen(
              'http://127.0.0.1:8000/.well-known/dwarpal-configuration').read()"
            counts="$(ask 'query?query=sum(http_server_duration_milliseconds_count)' || true)"
            share="$(ask 'query?query=dwarpal:server_error_ratio:rate5m' || true)"
            [[ "$counts" == *'"result":[{'* && "$share" == *'"result":[{'* ]] && break
            sleep 10
          done
          [[ "$counts" == *'"result":[{'* ]] || { echo "the API's counts never reached Prometheus: $counts"; exit 1; }
          [[ "$share" == *'"result":[{'* ]] || { echo "the availability rule computed nothing: $share"; exit 1; }
          rules="$(ask rules)"
          [[ "$rules" == *'"name":"dwarpal-slo"'* ]] || { echo "the alert rules aren't loaded: $rules"; exit 1; }
          managers="$(ask alertmanagers)"
          [[ "$managers" == *'alertmanager:9093'* ]] || { echo "Prometheus has no Alertmanager: $managers"; exit 1; }
          echo "::notice title=alerts pipeline::the API's counts reach Prometheus, the rules compute, Alertmanager listens"
      - name: The rehearsal's last lines, as an annotation
        if: failure() && matrix.name == 'api'
        shell: bash
        working-directory: infra/deploy
        run: '[ -f rehearsal.log ] && echo "::error title=rehearsal::$(tail -c 3000 rehearsal.log | tr "\n" "|")" || true'
