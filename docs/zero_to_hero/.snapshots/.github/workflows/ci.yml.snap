name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  python:
    name: Python - lint, types, tests, book
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
          enable-cache: true
      - run: uv sync --locked
      - run: uv run infra/scripts/fetch_models.py
      - run: sudo apt-get update && sudo apt-get install --yes --no-install-recommends tesseract-ocr
      - run: uv run tasks.py lint
      - run: uv run tasks.py typecheck
      # The tests, one step per run so each has its own time on record; each test's name is logged as it starts.
      - name: Tests - services, libraries, SDK
        timeout-minutes: 20
        shell: bash
        run: uv run python -m pytest docs/zero_to_hero/tests services libs packages/sdk-python -v --durations=15 2>&1 | tee services-tests.log
      - name: Tests - ML
        timeout-minutes: 15
        shell: bash
        run: uv run python -m pytest ml -v --durations=15 2>&1 | tee ml-tests.log
      - run: uv run tasks.py book
      # CI's logs need a GitHub sign-in; annotations don't. Post the slowest tests, and the last lines reached (the
      # test that was running if a step ran out of time), as annotations.
      - name: Test timings, as annotations
        if: always()
        shell: bash
        run: |
          for log in services-tests.log ml-tests.log; do
            [ -f "$log" ] || continue
            slowest=$(sed -n '/slowest .* durations/,/^=/p' "$log" | head -17 | tr '\n' '|')
            last=$(grep -E '::' "$log" | tail -3 | tr '\n' '|')
            echo "::notice title=$log::slowest: ${slowest:-none recorded} last reached: ${last:-none}"
          done

  javascript:
    name: JavaScript - lint, types, tests, builds
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm lint
      - run: pnpm typecheck
      - run: pnpm test
      - run: pnpm build

  e2e:
    name: End to end - a real browser through every service
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
          enable-cache: true
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24
          cache: pnpm
      - run: uv sync --locked
      - run: uv run infra/scripts/fetch_models.py
      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter @dwarpal/e2e exec playwright install --with-deps chromium firefox webkit
      - run: pnpm e2e
      - if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: e2e-results
          path: e2e/test-results
          retention-days: 7

  infrastructure:
    name: Compose - databases start healthy
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - run: docker compose -f infra/compose/compose.yaml up -d --wait
      - run: docker compose -f infra/compose/compose.yaml down -v
      # The server's alert settings (alerts by email, 2 Nov), checked by each program's own checker: Prometheus's with
      # the shared rules, the collector's, and Alertmanager's as alert_email.py writes them (a made-up password).
      - name: Production alert settings are valid
        run: |
          python3 - <<'PY'
          import importlib.util
          spec = importlib.util.spec_from_file_location("alert_email", "infra/deploy/alert_email.py")
          mail = importlib.util.module_from_spec(spec)
          spec.loader.exec_module(mail)
          config = mail.alertmanager_config("owner@example.org", "smtp.example.org:587", "sender@example.org")
          open("alertmanager.yml", "w").write(config)
          open("smtp_password", "w").write("not-a-real-password")
          PY
          docker run --rm --entrypoint promtool \
            -v "$PWD/infra/deploy/prometheus.yaml:/etc/prometheus/prometheus.yaml:ro" \
            -v "$PWD/infra/observability/alerts.yaml:/etc/prometheus/alerts.yaml:ro" \
            prom/prometheus:v3.13.4 check config /etc/prometheus/prometheus.yaml
          docker run --rm -v "$PWD/infra/deploy/collector.yaml:/config.yaml:ro" \
            otel/opentelemetry-collector-contrib:0.163.1 validate --config=/config.yaml
          docker run --rm --entrypoint amtool \
            -v "$PWD/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro" \
            -v "$PWD/smtp_password:/etc/alertmanager/smtp_password:ro" \
            prom/alertmanager:v0.34.1 check-config /etc/alertmanager/alertmanager.yml

  helm:
    name: Helm - the Kubernetes chart lints and renders
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      HELM: helm-v4.3.1-linux-amd64.tar.gz
      HELM_SHA256: 0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # Helm 4.3.1 (decision D19), from Helm's own site, used only if its SHA-256 is the one written above.
      - run: |
          curl --fail --silent --show-error --location --output "$HELM" "https://get.helm.sh/$HELM"
          echo "$HELM_SHA256  $HELM" | sha256sum --check --strict
          tar --extract --gzip --file "$HELM" linux-amd64/helm
      - name: Lint and render
        shell: bash
        run: |
          ./linux-amd64/helm lint --strict infra/helm/dwarpal 2>&1 | tee helm.log
          ./linux-amd64/helm template dwarpal infra/helm/dwarpal > rendered.yaml 2>> helm.log
          echo "rendered $(grep -c '^kind:' rendered.yaml) objects" | tee -a helm.log
      # As for the tests: the end of Helm's output as an annotation, which anyone can read.
      - if: always()
        shell: bash
        run: '[ -f helm.log ] && echo "::notice title=helm::$(tail -c 2500 helm.log | tr "\n" "|")" || true'

  images:
    name: Images - the four production images build and start (Arm, never published)
    # Built exactly as the deploy workflow builds them — on GitHub's Arm machines, from the base images approved for
    # them (D17) — but kept here, never published: a broken image shows up on any push, not on the day of a deploy.
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 45
    strategy:
      fail-fast: false
      matrix:
        include:
          - { name: api, file: services/api/Dockerfile, args: "" }
          - { name: inference, file: services/inference/Dockerfile, args: "" }
          - { name: web, file: apps/Dockerfile, args: "APP=web" }
          - { name: demo-shop, file: apps/Dockerfile, args: "APP=demo-shop" }
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
      # The web app's build copies the face landmarker for browsers (the only model file an image contains).
      - if: matrix.name == 'web'
        run: uv run --no-project infra/scripts/fetch_models.py
      - name: Build
        shell: bash
        run: |
          args=(--build-arg "NEXT_PUBLIC_DWARPAL_API_URL=https://api.dwarpal.example")
          if [ -n "${{ matrix.args }}" ]; then args+=(--build-arg "${{ matrix.args }}"); fi
          docker build -f "${{ matrix.file }}" "${args[@]}" -t "dwarpal-${{ matrix.name }}:ci" .
      # Each image is started the way the server would, as far as it can be without the rest: the Python services
      # load all their code (and the inference service finds Tesseract); the web app serves a verify page.
      - name: Start
        shell: bash
        run: |
          image="dwarpal-${{ matrix.name }}:ci"
          case "${{ matrix.name }}" in
            api) docker run --rm "$image" python -m dwarpal_api.cli --help > /dev/null ;;
            inference)
              docker run --rm "$image" python -c "import dwarpal_inference.main"
              docker run --rm "$image" tesseract --version ;;
            web)
              docker run --detach --name web --publish 3000:3000 "$image"
              curl --fail --silent --show-error --retry 20 --retry-connrefused --retry-all-errors --retry-delay 1 \
                --output /dev/null http://localhost:3000/v/vs_01M51KF05CE4GSBH7F0G43G01V \
                || { docker logs web 2>&1 | tail -20; exit 1; } ;;
            demo-shop) docker run --rm "$image" node -e "require.resolve('next'); require('fs').accessSync('.next/BUILD_ID')" ;;
          esac
