import type { ReactNode } from "react";

/** The console is written in English only (decision D2 translated the public pages): its content says so, whatever
 * language the page as a whole is in, so screen readers read it as English. `contents` keeps the layout unchanged. */
export default function ConsoleLayout({ children }: { children: ReactNode }) {
  return (
    <div lang="en" className="contents">
      {children}
    </div>
  );
}
