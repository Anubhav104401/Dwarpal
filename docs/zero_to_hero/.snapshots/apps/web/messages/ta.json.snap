  "Tips": {
    "default": "புகைப்படங்கள் சரியாக வரவில்லை. தயவுசெய்து நல்ல, சீரான வெளிச்சத்தில் மீண்டும் முயலுங்கள்.",
    "undecodable": "உங்கள் கேமராவின் படங்களைப் படிக்க முடியவில்லை. தயவுசெய்து மீண்டும் முயலுங்கள்.",
    "no_face": "முகம் எதுவும் தெரியவில்லை. கேமராவை நேராகப் பாருங்கள்.",
    "multiple_faces": "ஒன்றுக்கு மேற்பட்ட முகங்கள் தெரிகின்றன. நீங்கள் மட்டுமே தெரிவதை உறுதிசெய்யுங்கள்.",
    "face_too_small": "கேமராவுக்கு இன்னும் கொஞ்சம் அருகில் வாருங்கள்.",
    "too_dark": "மிகவும் இருட்டாக உள்ளது. ஜன்னல் அல்லது விளக்கை நோக்கி முகத்தை வையுங்கள்.",
    "too_bright": "வெளிச்சம் மிக அதிகம். உங்களுக்குப் பின்னால் உள்ள பிரகாசமான விளக்குகளிலிருந்து விலகித் திரும்புங்கள்.",
    "too_blurry": "புகைப்படங்கள் மங்கலாக வந்தன. அவை எடுக்கப்படும்போது அசையாமல் இருங்கள்.",
    "not_frontal": "பக்கவாட்டில் அல்ல, கேமராவை நேராகப் பாருங்கள்.",
    "low_confidence": "உங்கள் முகம் தெளிவாகத் தெரியவில்லை. முகத்தை மறைக்காமல் மீண்டும் முயலுங்கள்.",
    "inconsistent_frames": "புகைப்படங்கள் எடுக்கப்படும்போது அசையாமல், சட்டகத்துக்குள்ளேயே இருங்கள்.",
    "analysis_unavailable": "சரிபார்க்கும் அமைப்பு இப்போது பணியில் உள்ளது. தயவுசெய்து சற்று நேரத்தில் மீண்டும் முயலுங்கள்.",
    "liveness_check_failed": "திரையில் வரும் அறிவுறுத்தல்களைப் பின்பற்றுங்கள்: கேட்கும்போது தலையைத் திருப்புங்கள், முகம் சட்டகத்துக்குள் இருக்கட்டும்.",
    "liveness_unavailable": "சரிபார்ப்பை எங்களால் முடிக்க முடியவில்லை. தயவுசெய்து மீண்டும் முயலுங்கள்.",
    "mrz_not_found": "புகைப்படப் பக்கத்தின் கீழே எழுத்துகளும் '<<<' வரிகளும் கிடைக்கவில்லை. அதைச் சமமாக வைத்து, படம் முழுவதும் நிரப்புங்கள்.",
    "mrz_unreadable": "புகைப்படப் பக்கத்தின் கீழே உள்ள வரிகளைப் படிக்க முடியவில்லை. ஒளிப் பிரதிபலிப்பைத் தவிர்த்து, கேமராவை அசையாமல் பிடியுங்கள்.",
    "mrz_check_failed": "புகைப்படப் பக்கத்தின் கீழே உள்ள வரிகளைத் தெளிவாகப் படிக்க முடியவில்லை. நல்ல வெளிச்சத்தில், பிரதிபலிப்பு இல்லாமல் மீண்டும் முயலுங்கள்.",
    "document_face_not_found": "உங்கள் ஆவணத்தில் உள்ள புகைப்படம் தெரியவில்லை. புகைப்படப் பக்கம் முழுவதையும் காட்டுங்கள்.",
    "face_not_found": "செல்ஃபியில் உங்கள் முகம் தெரியவில்லை. கேமராவை நேராகப் பாருங்கள்.",
    "face_mismatch": "உங்கள் செல்ஃபி ஆவணத்தில் உள்ள புகைப்படத்துடன் பொருந்தவில்லை. நல்ல வெளிச்சத்தில் உங்கள் சொந்த ஆவணத்தைப் பயன்படுத்துங்கள்.",
    "aadhaar_or_mrz_not_found": "அந்தப் படத்தில் ஆதார் QR குறியீடும் கிடைக்கவில்லை, பாஸ்போர்ட்டின் '<<<' வரிகளும் கிடைக்கவில்லை. குறியீடு சட்டகம் முழுவதையும் நிரப்பும் தெளிவான படத்தைப் பயன்படுத்துங்கள்.",
    "aadhaar_qr_unreadable": "ஒரு QR குறியீடு கிடைத்தது, ஆனால் அதை ஆதார் செக்யூர் QR ஆகப் படிக்க முடியவில்லை. பெரிய குறியீட்டைப் பயன்படுத்துங்கள்: தெளிவாக, சமமாக, படம் முழுவதும் நிரம்பியபடி.",
    "aadhaar_signature_invalid": "இந்த QR குறியீட்டில் UIDAI-இன் கையொப்பம் இல்லை; எனவே இதைப் பயன்படுத்த முடியாது. உங்கள் சொந்த ஆதார் கடிதம், அட்டை அல்லது இ-ஆதாரில் உள்ள குறியீட்டைப் பயன்படுத்துங்கள்.",
    "aadhaar_test_only": "ஆதார் QR குறியீடுகள் சோதனைச் சரிபார்ப்புகளில் மட்டுமே ஏற்கப்படுகின்றன. தயவுசெய்து பாஸ்போர்ட் அல்லது அடையாள அட்டையைப் பயன்படுத்துங்கள்.",
    "document_unusable": "அந்தக் கோப்பைப் பயன்படுத்த முடியவில்லை. அதற்குப் பதிலாக ஒரு புகைப்படம் எடுக்கவும்.",
    "camera_unavailable": "கேமராவைத் திறக்க முடியவில்லை. அதற்குப் பதிலாக உங்கள் ஆவணத்தின் புகைப்படத்தைத் தேர்ந்தெடுக்கவும்."
  },
  "Problems": {
