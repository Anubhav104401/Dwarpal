# Copy this file to apps/demo-shop/.env.local and fill it in. A real .env.local is never committed.

# Where the Dwarpal API is, and the issuer name its tokens carry (the same address in development).
DWARPAL_API_URL=http://localhost:8000
DWARPAL_ISSUER=http://localhost:8000

# Printed by: uv run --package dwarpal-api python -m dwarpal_api.cli seed-dev
DWARPAL_PROJECT_ID=prj_REPLACE_ME
DWARPAL_API_KEY=dk_test_REPLACE_ME

# The shop's own address, and a long random secret for signing its cookie. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SHOP_URL=http://localhost:3100
SHOP_SECRET=

# Optional: the policy the shop's checks follow, when it shouldn't be the preset (uk_osa_18). Needed with an age model
# that has no pass marks for the presets' risk budget: make a policy in the console, and name it here.
# DWARPAL_POLICY=shop_18
