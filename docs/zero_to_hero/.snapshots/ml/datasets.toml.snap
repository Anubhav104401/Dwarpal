# The licence register: every dataset Dwarpal may train or evaluate on, where it comes from, and what its
# licence allows. A dataset is fetched only after the project owner has approved it (`approved = true`), and every
# file is pinned by its SHA-256 fingerprint. Models list the datasets that trained them, so their terms follow them.

[[dataset]]
name = "fairface"
title = "FairFace"
homepage = "https://github.com/dchen236/FairFace"
licence = "CC BY 4.0"
permitted_use = "commercial and non-commercial use, with attribution"
citation = "K. Karkkainen and J. Joo, FairFace: Face Attribute Dataset for Balanced Race, Gender, and Age, WACV 2021"
age_labels = "ranges"
approved = true
approved_on = 2026-10-16

[[dataset.files]]
# The wide-margin images (padding 1.25): alignment needs the hair and surroundings that the tight crops cut off.
name = "fairface-img-margin125-trainval.zip"
url = "https://drive.usercontent.google.com/download?id=1g7qNOZz9wC7OfOhcPqH1EZ5bk1UFGmlL&export=download&confirm=t"
sha256 = "033bb5c7ff6d2a24501f9b24c132e6b11702267d6776b19295231b4e36f7bb2b"
bytes = 2094293825

[[dataset.files]]
name = "fairface_label_train.csv"
url = "https://drive.usercontent.google.com/download?id=1i1L3Yqwaio7YSOCj7ftgk8ZZchPG7dmH&export=download&confirm=t"
sha256 = "90624451f2214ae1aa84021ae51c19ce45a375bd0bff901b935feadc59514795"
bytes = 3793020

[[dataset.files]]
name = "fairface_label_val.csv"
url = "https://drive.usercontent.google.com/download?id=1wOdja-ezstMEp81tX1a-EYkFebev4h7D&export=download&confirm=t"
sha256 = "19906f6917373dc19385e23ff0bacb75767fd0f99569ae6201d268af33d4c96b"
bytes = 447631

[[dataset]]
name = "utkface"
title = "UTKFace (aligned and cropped)"
homepage = "https://susanqq.github.io/UTKFace/"
licence = "non-commercial research only"
permitted_use = "non-commercial research"
citation = "Z. Zhang, Y. Song and H. Qi, Age Progression/Regression by Conditional Adversarial Autoencoder, CVPR 2017"
age_labels = "exact"
approved = false

[[dataset]]
name = "appa-real"
title = "APPA-REAL"
homepage = "https://chalearnlap.cvc.uab.cat/dataset/26/description/"
licence = "no licence stated; citation required"
permitted_use = "research, pending clarification"
citation = "E. Agustsson et al., Apparent and real age estimation in still images with deep residual regressors on APPA-REAL database, FG 2017"
age_labels = "exact"
approved = false

[[dataset]]
name = "imdb-clean"
title = "IMDB-Clean (labels) over IMDB-WIKI face crops"
homepage = "https://github.com/ibug-group/fpage"
licence = "research use"
permitted_use = "non-commercial research"
citation = "Y. Lin, J. Shen, Y. Wang and M. Pantic, FP-Age: Leveraging Face Parsing Attention for Facial Age Estimation in the Wild, IEEE TIP 2022"
age_labels = "exact"
approved = false
