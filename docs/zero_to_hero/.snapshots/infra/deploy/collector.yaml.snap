# The OpenTelemetry collector on the server (alerts by email, 2 Nov): receives the API's metrics and offers them for
# Prometheus to collect. The server keeps no traces (there is no Tempo here), so the traces it is sent are dropped.
receivers:
  otlp:
    protocols:
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch: {}

exporters:
  prometheus:
    endpoint: 0.0.0.0:8889 # Prometheus reads the metrics from here (prometheus.yaml)
  nop: {} # accepts and forgets

service:
  pipelines:
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [prometheus]
    traces:
      receivers: [otlp]
      exporters: [nop]
