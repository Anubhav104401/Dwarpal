# Prometheus on the server (alerts by email, 2 Nov): collects the API's metrics from the collector, checks the alert
# rules against them (alerts.yaml, the same rules as on a laptop), and hands the alerts that fire to Alertmanager.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yaml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: dwarpal
    static_configs:
      - targets: ["collector:8889"]
