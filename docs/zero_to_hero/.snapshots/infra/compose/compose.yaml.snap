# Dwarpal: local development infrastructure (the databases the services need).
#   start:  docker compose -f infra/compose/compose.yaml up -d --wait
#   stop:   docker compose -f infra/compose/compose.yaml down      (add -v to delete the data too)
#   traces: docker compose -f infra/compose/compose.yaml --profile observability up -d
#           then run the API with DWARPAL_OTEL_ENDPOINT=http://127.0.0.1:4318, and open Grafana at http://localhost:3300
#           (its "Dwarpal API" dashboard), or Prometheus's alerts at http://localhost:9090/alerts

name: dwarpal

services:
  postgres:
    image: postgres:18.6-alpine3.24
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-dwarpal}
      POSTGRES_USER: ${POSTGRES_USER:-dwarpal}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-dwarpal-local-only}
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 20
    restart: unless-stopped

  valkey:
    image: valkey/valkey:9.1.2-alpine3.24
    command: ["valkey-server", "--appendonly", "yes"]
    ports:
      - "127.0.0.1:${VALKEY_PORT:-6379}:6379"
    volumes:
      - valkeydata:/data
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
    restart: unless-stopped

  # Seeing traces and metrics (Phase 7, D11), only when asked for (`--profile observability`): the collector passes
  # traces to Tempo and offers metrics to Prometheus; Grafana shows both.
  collector:
    image: otel/opentelemetry-collector-contrib:0.163.1
    profiles: [observability]
    command: ["--config=/etc/otelcol/config.yaml"]
    volumes:
      - ../observability/collector.yaml:/etc/otelcol/config.yaml:ro
    ports:
      - "127.0.0.1:4318:4318"
    depends_on: [tempo]

  tempo:
    image: grafana/tempo:2.10.9
    profiles: [observability]
    command: ["-config.file=/etc/tempo.yaml"]
    user: "0" # the data volume starts owned by root
    volumes:
      - ../observability/tempo.yaml:/etc/tempo.yaml:ro
      - tempodata:/var/tempo
    ports:
      - "127.0.0.1:3200:3200"

  prometheus:
    image: prom/prometheus:v3.13.4
    profiles: [observability]
    command: ["--config.file=/etc/prometheus/prometheus.yaml"]
    volumes:
      - ../observability/prometheus.yaml:/etc/prometheus/prometheus.yaml:ro
      - ../observability/alerts.yaml:/etc/prometheus/alerts.yaml:ro
    ports:
      - "127.0.0.1:9090:9090"
    depends_on: [collector]

  grafana:
    image: grafana/grafana:13.0.11
    profiles: [observability]
    environment:
      # No sign-in, as an admin: acceptable only because it listens on this computer alone (127.0.0.1).
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Admin
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
    volumes:
      - ../observability/grafana-datasources.yaml:/etc/grafana/provisioning/datasources/datasources.yaml:ro
      - ../observability/grafana-dashboards.yaml:/etc/grafana/provisioning/dashboards/dashboards.yaml:ro
      - ../observability/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - "127.0.0.1:3300:3000"
    depends_on: [tempo, prometheus]

volumes:
  pgdata:
  valkeydata:
  tempodata:
