# The OpenTelemetry collector (Phase 7, D11): receives the API's traces and metrics over HTTP; passes traces to Tempo,
# and offers the metrics for Prometheus to collect.
receivers:
  otlp:
    protocols:
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch: {}

exporters:
  otlp/tempo:
    endpoint: tempo:4317
    tls:
      insecure: true # inside Docker's private network, between two local containers
  prometheus:
    endpoint: 0.0.0.0:8889 # Prometheus reads the metrics from here (prometheus.yaml)

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp/tempo]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [prometheus]
