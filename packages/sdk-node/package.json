{
  "name": "@dwarpal/node",
  "version": "0.1.0",
  "description": "Server-side SDK for Dwarpal: create age-verification sessions and verify the signed age tokens.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@dwarpal/config": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
