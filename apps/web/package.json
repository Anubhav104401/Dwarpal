  },
  "devDependencies": {
    "@dwarpal/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
